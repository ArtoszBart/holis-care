{
  "cli": {
    "version": ">= 16.6.2",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_SENTRY_ENABLE": "false",
        "EXPO_PUBLIC_API_URL": "http://192.168.0.95:8080/api/v1"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_SENTRY_ENABLE": "true",
        "EXPO_PUBLIC_API_URL": "https://api.holis.care/api/v1"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
