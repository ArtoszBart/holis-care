{
  "expo": {
    "name": "Holis Care",
    "slug": "holis-mobile",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./src/assets/icons/ios-light.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./src/assets/icons/splash-icon-dark.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.artoszbart.holismobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "userInterfaceStyle": "light",
      "icon": {
        "dark": "./src/assets/icons/ios-dark.png",
        "light": "./src/assets/icons/ios-light.png",
        "tinted": "./src/assets/icons/ios-tinted.png"
      }
    },
    "android": {
      "package": "com.artoszbart.holismobile",
      "userInterfaceStyle": "light",
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/icons/adaptive-icon.png",
        "monochromeImage": "./src/assets/icons/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "plugins": [
      ["./expo-plugins/withDisableForcedDarkModeAndroid.js", {}],
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/icons/splash-icon-dark.png",
          "dark": {
            "image": "./src/assets/icons/splash-icon-light.png",
            "backgroundColor": "#000000"
          },
          "imageWidth": 180
        }
      ],
      "expo-secure-store",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "holis-mobile",
          "organization": "holis-s7"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "648efad0-9827-4775-8b24-9d8c3eaa196b"
      }
    },
    "owner": "artoszbart"
  }
}
